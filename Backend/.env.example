# Copy to .env and fill in. Never commit .env.
PORT=3000

# Supabase: Project Settings > API. The service role key bypasses RLS, so keep it server-side only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# S3 media storage. Credentials come from the default AWS chain (e.g. `aws login`).
AWS_REGION=af-south-1
S3_BUCKET=mshasha

# Admin login. Generate both lines with `npm run hash-password`.
# Changing either value logs out all admin sessions.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=